rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- PILLAR 0: Global Safety Net ----
    match /{document=**} {
      allow read, write: if false;
    }

    // ---- PILLAR 3: Path Variable Hardening & Global Helpers ----
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Auth tokens NEVER contain custom claims. Verify against trusted source.
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rachiddmachmacha@gmail.com' ||
        request.auth.token.email == 'admin@negocimo.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ---- PILLAR 2: Validation Blueprints (The "Anti-Update-Gap") ----
    
    function isValidProduct(data) {
      return data.name is string && data.name.size() > 0 &&
             data.category is string &&
             data.price is string &&
             data.stock is number &&
             data.status is string && data.status.matches('^(Actif|Inactif|Rupture)$') &&
             data.image is string && data.image.size() <= 6000000 &&
             (!data.keys().hasAny(["description"]) || data.description is string) &&
             (!data.keys().hasAny(["slug"]) || data.slug is string) &&
             (!data.keys().hasAny(["updatedAt"]) || data.updatedAt is string) &&
             (!data.keys().hasAny(["id"]) || data.id is string) &&
             (!data.keys().hasAny(["tags"]) || data.tags is list) &&
             (!data.keys().hasAny(["features"]) || data.features is list);
    }

    function isValidSector(data) {
      return data.keys().hasAll(["id", "name", "description", "imageUrl", "size", "order"]) &&
             data.id is string && data.id.matches('^[a-z0-9-]+$') &&
             data.name is string && data.name.size() <= 200 &&
             data.description is string && data.description.size() <= 2000 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.size is string && data.size.matches('^(small|large)$') &&
             data.order is number;
    }

    function isValidProject(data) {
      return data.keys().hasAll(["title", "sector", "imageUrl", "isLarge"]) &&
             data.title is string && data.title.size() <= 200 &&
             data.sector is string && data.sector.size() <= 100 &&
             data.imageUrl is string && data.imageUrl.size() <= 1000 &&
             data.isLarge is bool &&
             (!data.keys().hasAny(["surface"]) || (data.surface is string && data.surface.size() <= 50)) &&
             (!data.keys().hasAny(["description"]) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidSettings(data) {
      return data.keys().hasAll(["companyName", "email", "phone", "address", "heroTitle", "heroSubtitle", "updatedAt"]) &&
             data.companyName is string && data.companyName.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.address is string && data.address.size() <= 500 &&
             data.heroTitle is string && data.heroTitle.size() <= 200 &&
             data.heroSubtitle is string && data.heroSubtitle.size() <= 1000 &&
             (!data.keys().hasAny(["logoUrl"]) || (data.logoUrl is string && data.logoUrl.size() <= 1000000)) &&
             (!data.keys().hasAny(["primaryColor"]) || (data.primaryColor is string && data.primaryColor.size() <= 30)) &&
             (!data.keys().hasAny(["secondaryColor"]) || (data.secondaryColor is string && data.secondaryColor.size() <= 30)) &&
             (!data.keys().hasAny(["backgroundColor"]) || (data.backgroundColor is string && data.backgroundColor.size() <= 30)) &&
             (!data.keys().hasAny(["whatsappNumber"]) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30)) &&
             (!data.keys().hasAny(["textColor"]) || (data.textColor is string && data.textColor.size() <= 30)) &&
             (!data.keys().hasAny(["headingColor"]) || (data.headingColor is string && data.headingColor.size() <= 30)) &&
             (!data.keys().hasAny(["heroImage"]) || (data.heroImage is string && data.heroImage.size() <= 1000000)) &&
             (!data.keys().hasAny(["aboutTitle"]) || (data.aboutTitle is string && data.aboutTitle.size() <= 200)) &&
             (!data.keys().hasAny(["aboutText"]) || (data.aboutText is string && data.aboutText.size() <= 10000)) &&
             (!data.keys().hasAny(["aboutImage"]) || (data.aboutImage is string && data.aboutImage.size() <= 1000000)) &&
             (!data.keys().hasAny(["ctaTitle"]) || (data.ctaTitle is string && data.ctaTitle.size() <= 200)) &&
             (!data.keys().hasAny(["ctaText"]) || (data.ctaText is string && data.ctaText.size() <= 2000)) &&
             (!data.keys().hasAny(["showStats"]) || data.showStats is bool) &&
             (!data.keys().hasAny(["showTestimonials"]) || data.showTestimonials is bool) &&
             (!data.keys().hasAny(["showClients"]) || data.showClients is bool);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(["name", "email", "phone", "message", "status", "createdAt"]) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.email is string && data.email.size() <= 200 &&
             data.phone is string && data.phone.size() <= 50 &&
             data.message is string && data.message.size() > 0 && data.message.size() <= 5000 &&
             data.status is string && data.status == 'New' &&
             data.createdAt == request.time;
    }

    function isValidAdmin(data) {
      return data.keys().hasAll(["email", "createdAt"]) &&
             data.email is string && data.email.size() <= 200 &&
             data.createdAt == request.time;
    }

    // ---- PILLAR 1: The "Master Gate" & Paths ----

    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isAdmin() && isValidId(productId) && isValidProduct(incoming());
      allow delete: if isAdmin();
    }

    match /sectors/{sectorId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidId(sectorId) && isValidSector(incoming());
      allow delete: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      // PILLAR 7: Atomicity (ensure sector exists)
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                    exists(/databases/$(database)/documents/sectors/$(incoming().sector));
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) &&
                    exists(/databases/$(database)/documents/sectors/$(incoming().sector));
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(settingId) && isValidSettings(incoming());
    }

    match /messages/{messageId} {
      // PILLAR 8: Secure List Queries
      allow read: if isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update: if isAdmin() && isValidId(messageId) && 
                      (incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status.matches('^(Read|Replied)$'));
      allow delete: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(adminId) && isValidAdmin(incoming());
      allow update: if isAdmin() && isValidId(adminId) && incoming().email == existing().email;
      allow delete: if isAdmin() && adminId != request.auth.uid; // Prevent self-deletion
    }
  }
}
